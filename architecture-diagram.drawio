        </mxCell>
        <mxCell id="subtitulo3" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Cada flecha indica quién publica/consume o quién valida contra quién — ver Parte 1 y 2 del taller" vertex="1">
          <mxGeometry height="20" width="820" x="40" y="38" as="geometry" />
        </mxCell>

