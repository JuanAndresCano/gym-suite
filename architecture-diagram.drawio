          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="491" y="290" /><mxPoint x="850" y="290" /></Array>
            <mxPoint as="offset" x="0" y="-8" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jwt4" edge="1" parent="1" source="equipos" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;strokeColor=#d79b00;exitX=0.3;exitY=1;entryX=0;entryY=0.9;" value="valida JWT">
          <mxGeometry relative="1" as="geometry">
