        <mxCell id="subtitulo" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="4 contextos acotados con base de datos propia · seguridad centralizada (Keycloak) · mensajería asincrónica (RabbitMQ / Kafka)" vertex="1">
