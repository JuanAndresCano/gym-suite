        <mxCell id="s_miembros" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Miembros&lt;/b&gt; :8081" vertex="1">
