        <!-- ================= INFRAESTRUCTURA (columna derecha) ================= -->
        <mxCell id="keycloak" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;realm gimnasio · :8080&lt;br&gt;valida JWT de los 4 servicios&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="940" y="180" as="geometry" />
        </mxCell>
        <mxCell id="rabbitmq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;RabbitMQ&lt;/b&gt; · :5672&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• notificaciones.inscripciones.queue&lt;br&gt;• horarios.exchange (fanout)&lt;br&gt;• pagos-queue → pagos-dlq&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="940" y="320" as="geometry" />
        </mxCell>
        <mxCell id="kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Kafka&lt;/b&gt; · :29092&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• ocupacion-clases&lt;br&gt;• datos-entrenamiento → resumen-entrenamiento&lt;br&gt;&amp;nbsp;&amp;nbsp;(Kafka Streams, ventana 7 días)&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="300" x="940" y="470" as="geometry" />
        </mxCell>

        <!-- Bus de 10 lineas paralelas: bajan de cada servicio, viajan por la franja libre
