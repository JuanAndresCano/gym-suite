        </mxCell>
        <mxCell id="db_clases" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#b0e3e6;strokeColor=#0b8299;fontSize=13;" value="&amp;laquo;database&amp;raquo;&lt;br&gt;&lt;b&gt;clasesdb&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;H2 en archivo&lt;/font&gt;" vertex="1">
