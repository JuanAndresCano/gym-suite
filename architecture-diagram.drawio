        </mxCell>
        <mxCell id="ll3" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="465" y="598" as="sourcePoint" /><mxPoint x="525" y="598" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ll3t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="Streaming de eventos Kafka" vertex="1">
          <mxGeometry height="20" width="280" x="535" y="588" as="geometry" />
        </mxCell>

        <mxCell id="nota2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=10;verticalAlign=top;spacingTop=4;" value="Equipos-service no participa de RabbitMQ ni Kafka en este taller: solo consume seguridad de Keycloak, igual que los otros tres." vertex="1">
          <mxGeometry height="90" width="330" x="40" y="520" as="geometry" />
        </mxCell>
      </root>
