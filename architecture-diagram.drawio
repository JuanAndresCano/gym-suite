          <mxGeometry height="60" width="160" x="260" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s_entrenadores" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Entrenadores&lt;/b&gt; :8083" vertex="1">
          <mxGeometry height="60" width="160" x="480" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s_equipos" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Equipos&lt;/b&gt; :8084" vertex="1">
          <mxGeometry height="60" width="160" x="700" y="90" as="geometry" />
        </mxCell>

        <!-- Keycloak: unico servicio del que dependen los 4 -> caja ancha centrada, entradas alineadas verticalmente con cada servicio -->
        <mxCell id="keycloak" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;Keycloak&lt;/b&gt; — realm &lt;i&gt;gimnasio&lt;/i&gt; · :8080&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Emite y valida JWT · roles ROLE_ADMIN / ROLE_TRAINER / ROLE_MEMBER&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="820" x="40" y="210" as="geometry" />
        </mxCell>

        <mxCell id="jwt1" edge="1" parent="1" source="s_miembros" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.135;entryY=0;entryDx=0;entryDy=0;" value="valida JWT">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-15" /></mxGeometry>
        </mxCell>
        <mxCell id="jwt2" edge="1" parent="1" source="s_clases" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.385;entryY=0;entryDx=0;entryDy=0;" value="valida JWT">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-15" /></mxGeometry>
        </mxCell>
        <mxCell id="jwt3" edge="1" parent="1" source="s_entrenadores" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.635;entryY=0;entryDx=0;entryDy=0;" value="valida JWT">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-15" /></mxGeometry>
        </mxCell>
        <mxCell id="jwt4" edge="1" parent="1" source="s_equipos" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.885;entryY=0;entryDx=0;entryDy=0;" value="valida JWT">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-15" /></mxGeometry>
        </mxCell>

        <!-- RabbitMQ: solo miembros, clases y entrenadores -->
        <mxCell id="rabbitmq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• notificaciones.inscripciones.queue&lt;br&gt;• horarios.exchange (fanout)&lt;br&gt;• pagos-queue → pagos-dlq&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="mq1" edge="1" parent="1" source="s_clases" target="rabbitmq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;exitX=0.3;exitY=1;entryX=0.6;entryY=0;" value="publica inscripción + cambio horario">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-40" /></mxGeometry>
        </mxCell>
        <mxCell id="mq2" edge="1" parent="1" source="rabbitmq" target="s_miembros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;exitX=0.3;exitY=0;entryX=0.7;entryY=1;" value="consume notificación + horario">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="20" /></mxGeometry>
        </mxCell>
        <mxCell id="mq3" edge="1" parent="1" source="rabbitmq" target="s_entrenadores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;exitX=0.9;exitY=0;entryX=0.2;entryY=1;" value="consume horario">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="30" y="20" /></mxGeometry>
        </mxCell>
        <mxCell id="mq4" edge="1" parent="1" source="s_miembros" target="rabbitmq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;exitX=0.7;exitY=1;entryX=0.15;entryY=0;" value="pagos-queue ⇄ pagos-dlq">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-25" /></mxGeometry>
        </mxCell>

        <!-- Kafka: solo clases y miembros -->
        <mxCell id="kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• ocupacion-clases&lt;br&gt;• datos-entrenamiento → resumen-entrenamiento&lt;br&gt;&amp;nbsp;&amp;nbsp;(Kafka Streams, ventana 7 días)&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="450" y="360" as="geometry" />
        </mxCell>
        <mxCell id="kf1" edge="1" parent="1" source="s_clases" target="kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#6c8ebf;exitX=0.8;exitY=1;entryX=0.1;entryY=0;" value="produce/consume ocupacion-clases">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-40" /></mxGeometry>
        </mxCell>
        <mxCell id="kf2" edge="1" parent="1" source="s_miembros" target="kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#6c8ebf;exitX=0.9;exitY=1;entryX=0.3;entryY=0;" value="produce datos-entrenamiento / consume resumen">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="60" y="-25" /></mxGeometry>
        </mxCell>

        <!-- Leyenda, en su propia esquina, fuera del camino de cualquier flecha -->
        <mxCell id="leyenda_caja2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=11;fontStyle=1" value="Leyenda" vertex="1">
          <mxGeometry height="110" width="380" x="450" y="520" as="geometry" />
        </mxCell>
        <mxCell id="ll1" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="465" y="548" as="sourcePoint" /><mxPoint x="525" y="548" as="targetPoint" /></mxGeometry>
