        <mxCell id="ll1t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="Autenticación / autorización (Keycloak)" vertex="1">
          <mxGeometry height="20" width="280" x="535" y="538" as="geometry" />
        </mxCell>
        <mxCell id="ll2" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;" edge="1" parent="1">
