             giran a la derecha hacia la columna de infraestructura. -->

        <!-- -> Keycloak (los 4 servicios) -->
        <mxCell id="jwt1" edge="1" parent="1" source="miembros" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;strokeColor=#d79b00;exitX=0.15;exitY=1;entryX=0;entryY=0.15;" value="valida JWT">
