<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura con API Gateway" id="gw-arch-01">
    <mxGraphModel dx="1030" dy="562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Sistema de Gestión de un Gimnasio — Arquitectura con API Gateway" vertex="1"><mxGeometry height="30" width="1220" x="40" y="-70" as="geometry" /></mxCell>
        <mxCell id="subtitulo" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="un único punto de entrada (:8085) · seguridad en el borde · descubrimiento con Eureka · balanceo de carga" vertex="1"><mxGeometry height="20" width="1220" x="40" y="-42" as="geometry" /></mxCell>
        <mxCell id="cliente" parent="1" style="shape=umlActor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fontSize=12;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Cliente (Postman)&lt;/font&gt;" vertex="1"><mxGeometry height="80" width="60" x="60" y="20" as="geometry" /></mxCell>
        <mxCell id="gateway" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;API Gateway  :8085&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Spring Cloud Gateway (WebFlux)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• valida el JWT y los roles → 401 / 403&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• enruta con lb:// (Eureka + LoadBalancer)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• filtro global: log + X-Request-Id&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;• filtro ResumenMiembro (agregación)&lt;/font&gt;" vertex="1"><mxGeometry height="140" width="440" x="330" y="30" as="geometry" /></mxCell>
        <mxCell id="keycloak" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Keycloak&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;realm gimnasio · :8080&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;emite los JWT y publica sus claves (JWKS)&lt;/font&gt;" vertex="1"><mxGeometry height="100" width="300" x="940" y="20" as="geometry" /></mxCell>
        <mxCell id="miembros" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Miembros&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;:8081 · /api/miembros · /api/pagos&lt;/font&gt;" vertex="1"><mxGeometry height="70" width="190" x="40" y="290" as="geometry" /></mxCell>
        <mxCell id="clases" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Clases&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;:8082 · /api/clases&lt;/font&gt;" vertex="1"><mxGeometry height="70" width="190" x="260" y="290" as="geometry" /></mxCell>
        <mxCell id="entrenadores" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Entrenadores&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;:8083 · /api/entrenadores&lt;/font&gt;" vertex="1"><mxGeometry height="70" width="190" x="480" y="290" as="geometry" /></mxCell>
        <mxCell id="equipos" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Equipos&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;:8084 · /api/equipos&lt;/font&gt;" vertex="1"><mxGeometry height="70" width="190" x="700" y="290" as="geometry" /></mxCell>
        <mxCell id="entr2" parent="1" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;dashed=1;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;laquo;component&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Entrenadores (2.ª instancia)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;:8093 · solo en la demo de balanceo&lt;/font&gt;" vertex="1"><mxGeometry height="70" width="190" x="920" y="290" as="geometry" /></mxCell>
        <mxCell id="eureka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Eureka Server  :8761&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;registro y descubrimiento: cada servicio se registra con su nombre (miembros-service, clases-service…)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;el gateway pregunta a Eureka por las instancias y Spring Cloud LoadBalancer elige una (round-robin)&lt;/font&gt;" vertex="1"><mxGeometry height="80" width="1200" x="40" y="500" as="geometry" /></mxCell>
        <mxCell id="nota_resumen" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Filtro de agregación ResumenMiembro&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;GET /api/resumen/miembros/{id}: el gateway NO reenvía la petición. El filtro llama en&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;paralelo (timeout 3 s) a miembros-service (miembro + pagos) y a clases-service (clases&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;del miembro, con el nombre de su entrenador) y responde un solo JSON. Si clases o pagos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;fallan, devuelve esa parte en null y una lista de advertencias (degradación controlada).&lt;/font&gt;" vertex="1"><mxGeometry height="125" width="560" x="40" y="610" as="geometry" /></mxCell>
        <mxCell id="nota_seg" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" value="&lt;b&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Seguridad en dos capas&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;El gateway valida el JWT y aplica los roles: sin token → 401, rol insuficiente → 403,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;sin llegar al servicio. Además reenvía el header Authorization intacto, y cada&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;microservicio vuelve a validar el token por su cuenta (defensa en profundidad).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Las bases de datos H2 privadas, RabbitMQ y Kafka no cambian: ver el otro diagrama.&lt;/font&gt;" vertex="1"><mxGeometry height="125" width="600" x="640" y="610" as="geometry" /></mxCell>
        <mxCell id="c_gw" edge="1" parent="1" source="cliente" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.214;" value="2. petición HTTP + Bearer JWT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_kc" edge="1" parent="1" source="cliente" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#d79b00;dashed=1;exitX=0.500;exitY=0.000;entryX=0.500;entryY=0.000;" value="1. login: pide el token a Keycloak"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="-10" /><mxPoint x="1090" y="-10" /></Array></mxGeometry></mxCell>
        <mxCell id="gw_kc" edge="1" parent="1" source="gateway" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#d79b00;dashed=1;exitX=1.000;exitY=0.286;entryX=0.000;entryY=0.500;" value="valida la firma"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gw_m" edge="1" parent="1" source="gateway" target="miembros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;exitX=0.100;exitY=1.000;entryX=0.500;entryY=0.000;" value="lb://miembros-service"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="374" y="230" /><mxPoint x="135" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="gw_c" edge="1" parent="1" source="gateway" target="clases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;exitX=0.300;exitY=1.000;entryX=0.500;entryY=0.000;" value="lb://clases-service"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="462" y="250" /><mxPoint x="355" y="250" /></Array></mxGeometry></mxCell>
        <mxCell id="gw_e" edge="1" parent="1" source="gateway" target="entrenadores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;exitX=0.557;exitY=1.000;entryX=0.500;entryY=0.000;" value="lb://entrenadores-service"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="gw_q" edge="1" parent="1" source="gateway" target="equipos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;exitX=0.795;exitY=1.000;entryX=0.500;entryY=0.000;" value="lb://equipos-service"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="230" /><mxPoint x="795" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="gw_e2" edge="1" parent="1" source="gateway" target="entr2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#000000;dashed=1;exitX=1.000;exitY=0.857;entryX=0.500;entryY=0.000;" value="lb:// round-robin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="150" /></Array></mxGeometry></mxCell>
        <mxCell id="gw_eu" edge="1" parent="1" source="gateway" target="eureka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#6c8ebf;dashed=1;exitX=0.000;exitY=0.893;entryX=0.000;entryY=0.500;" value="descubre instancias"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="155" /><mxPoint x="15" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="r_m" edge="1" parent="1" source="miembros" target="eureka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#6c8ebf;dashed=1;exitX=0.500;exitY=1.000;entryX=0.079;entryY=0.000;" value="se registra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
