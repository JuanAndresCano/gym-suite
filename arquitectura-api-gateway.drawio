        <mxCell id="r_e" edge="1" parent="1" source="entrenadores" target="eureka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#6c8ebf;dashed=1;exitX=0.500;exitY=1.000;entryX=0.446;entryY=0.000;" value="se registra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r_q" edge="1" parent="1" source="equipos" target="eureka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#6c8ebf;dashed=1;exitX=0.500;exitY=1.000;entryX=0.629;entryY=0.000;" value="se registra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r_e2" edge="1" parent="1" source="entr2" target="eureka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#6c8ebf;dashed=1;exitX=0.500;exitY=1.000;entryX=0.812;entryY=0.000;" value="se registra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
